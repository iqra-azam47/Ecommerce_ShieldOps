@model ShieldOps.Models.ViewModels.ProductFilterViewModel
@{
    ViewData["Title"] = "Security Asset Catalog";
}

<div class="container-fluid mt-4 pb-5 mb-5">
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border border-secondary-subtle bg-body p-3 sticky-top" style="top: 20px;">
                <h5 class="fw-bold border-bottom border-secondary-subtle pb-2 text-body-emphasis">
                    <i class="bi bi-funnel-fill text-primary"></i> Asset Filters
                </h5>
                <form asp-controller="Catalog" asp-action="Index" method="get">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-body-emphasis font-monospace" style="letter-spacing: 0.5px;">Keyword Search</label>
                        <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control bg-body border-secondary-subtle text-body" placeholder="Search keywords..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-body-emphasis font-monospace" style="letter-spacing: 0.5px;">Operational Domain</label>
                        @foreach (var cat in Model.Categories)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input border-secondary-subtle" type="checkbox" name="SelectedCategories" value="@cat.Id" id="cat-@cat.Id"
                                @(Model.SelectedCategories.Contains(cat.Id) ? "checked" : "") />
                                <label class="form-check-label small fw-semibold text-body" for="cat-@cat.Id">@cat.Name</label>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-body-emphasis font-monospace" style="letter-spacing: 0.5px;">Asset Structure Type</label>
                        <div class="form-check mb-1">
                            <input class="form-check-input border-secondary-subtle" type="radio" name="SelectedType" value="" id="type-all" @(!Model.SelectedType.HasValue ? "checked" : "") />
                            <label class="form-check-label small fw-semibold text-body" for="type-all">All Assets</label>
                        </div>
                        <div class="form-check mb-1">
                            <input class="form-check-input border-secondary-subtle" type="radio" name="SelectedType" value="Physical" id="type-phys" @(Model.SelectedType == ShieldOps.Models.ProductType.Physical ? "checked" : "") />
                            <label class="form-check-label small fw-semibold text-body" for="type-phys">Physical Hardware</label>
                        </div>
                        <div class="form-check mb-1">
                            <input class="form-check-input border-secondary-subtle" type="radio" name="SelectedType" value="Digital" id="type-dig" @(Model.SelectedType == ShieldOps.Models.ProductType.Digital ? "checked" : "") />
                            <label class="form-check-label small fw-semibold text-body" for="type-dig">Digital Software License</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-body-emphasis font-monospace d-flex justify-content-between" style="letter-spacing: 0.5px;">
                            <span>Budget Ceiling</span>
                            <span class="text-primary fw-bold">$<span id="priceDisplay">@Model.MaxPrice</span></span>
                        </label>
                        <input type="range" name="MaxPrice" class="form-range" min="0" max="@Model.AbsoluteMaxPrice" step="5" value="@Model.MaxPrice" id="priceSlider" oninput="document.getElementById('priceDisplay').innerText = this.value;" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 text-uppercase fw-bold shadow-sm py-2 mb-2">
                        <i class="bi bi-sliders"></i> Apply Configuration
                    </button>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary w-100 text-uppercase fw-bold small py-2">
                        <i class="bi bi-arrow-clockwise"></i> Reset Core Dashboard
                    </a>
                
                </form>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary-subtle pb-2">
                <h3 class="fw-bold m-0 text-body-emphasis">Available Defensive Systems</h3>
                <span class="badge bg-dark border border-secondary text-white px-3 py-2 text-uppercase font-monospace" style="font-size: 11px;">Found: @Model.Products.Count Operations</span>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="alert alert-warning py-5 text-center shadow-sm border-0 rounded-3 bg-body-tertiary" role="alert">
                    <i class="bi bi-shield-slash-fill text-warning mb-2" style="font-size: 50px;"></i>
                    <h4 class="fw-bold text-body-emphasis">No active countermeasures found matching chosen parameters.</h4>
                    <p class="mb-0 text-body-secondary small">Try clearing out filters or broadening keywords from the console workspace.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var item in Model.Products)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border border-secondary-subtle bg-body d-flex flex-column">
                                
                                <div class="position-relative bg-dark rounded-top text-center" style="height: 180px; overflow: hidden;">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="w-100 h-100 object-fit-cover" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="d-flex h-100 align-items-center justify-content-center text-white-50">
                                            <i class="bi bi-shield-lock-fill fs-1"></i>
                                        </div>
                                    }
                                    <span class="position-absolute top-0 end-0 m-2 badge bg-dark border border-secondary text-white shadow-xs text-uppercase font-monospace" style="font-size: 10px;">
                                        @item.Type
                                    </span>
                                </div>
                                
                                <div class="card-body d-flex flex-column flex-grow-1 p-3">
                                    <h5 class="card-title fw-bold text-truncate mb-1" style="font-size: 17px;">
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-body-emphasis hover-text-primary">@item.Name</a>
                                    </h5>
                                    
                                    <p class="card-text text-body-secondary small flex-grow-1 mb-0 mt-2" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-align: justify; line-height: 1.4;">
                                        @item.Description
                                    </p>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary-subtle">
                                        <span class="fs-4 fw-bold text-success">$@item.Price.ToString("F2")</span>
                                        @if (item.StockQuantity <= 0)
                                        {
                                            <span class="text-danger fw-bold small"><i class="bi bi-x-octagon-fill"></i> Depleted</span>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary small fw-bold">Stock: @item.StockQuantity left</span>
                                        }
                                    </div>
                                </div>
                                
                                <div class="card-footer bg-transparent border-0 p-3 pt-0">
                                    @if (item.StockQuantity > 0)
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="m-0">
                                            <input type="hidden" name="productId" value="@item.Id" />
                                            <button type="submit" class="btn btn-primary w-100 fw-bold text-uppercase py-2 small shadow-xs">
                                                <i class="bi bi-cart-plus-fill"></i> Allocate to Cart
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary w-100 fw-bold text-uppercase py-2 small disabled" disabled>Unavailable</button>
                                    }
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>