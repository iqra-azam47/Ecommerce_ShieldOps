@model List<ShieldOps.Models.Order>
@{
    ViewData["Title"] = "Operations Dashboard - Deployed Asset Logs";
}

<div class="container mt-4 pb-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary-subtle pb-2">
        <h2 class="fw-bold m-0 text-body-emphasis"><i class="bi bi-folder-symlink-fill text-primary"></i> Operations History Vault</h2>
        <span class="badge bg-primary px-3 py-2 text-uppercase tracking-wider">Total Deployments: @Model.Count Modules</span>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center shadow-sm border border-secondary-subtle bg-body-tertiary rounded-3">
            <i class="bi bi-shield-slash text-body-secondary mb-3" style="font-size: 55px;"></i>
            <h4 class="fw-bold text-body-emphasis">No Active Manifest Telemetry Registered</h4>
            <p class="text-body-secondary small mb-4">You currently hold no structural procurement order records logged inside this infrastructure enclave root node.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary fw-bold text-uppercase px-4 py-2 shadow-xs mx-auto">Access Equipment Console</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card shadow-sm mb-4 border border-secondary-subtle bg-body">
                <div class="card-header bg-body-tertiary d-flex flex-wrap justify-content-between align-items-center border-bottom border-secondary-subtle p-3">
                    <div class="d-flex gap-4 text-body small">
                        <div>
                            <span class="d-block text-uppercase font-monospace text-primary fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">Tracking Manifest ID</span>
                            <strong class="text-body-emphasis fs-6">#SOPS-00@order.Id</strong>
                        </div>
                        <div>
                            <span class="d-block text-uppercase font-monospace text-body-secondary fw-semibold" style="font-size: 10px;">Deployment Clock Timestamp</span>
                            <span class="text-body-emphasis fs-6 fw-semibold">@order.OrderDate.ToLocalTime().ToString("g")</span>
                        </div>
                        <div>
                            <span class="d-block text-uppercase font-monospace text-body-secondary fw-semibold" style="font-size: 10px;">Settled Charge Surcharge</span>
                            <strong class="text-success fs-6">$@order.TotalAmount.ToString("F2")</strong>
                        </div>
                    </div>
                    <div class="mt-2 mt-md-0 d-flex align-items-center gap-2">
                        <a asp-controller="Order" asp-action="Track" asp-route-id="@order.Id" class="btn btn-primary btn-sm fw-bold text-uppercase px-3 shadow-sm">
                            <i class="bi bi-geo-alt-fill"></i> Track Live Node
                        </a>
                        <span class="badge bg-dark border border-secondary text-white px-3 py-2 text-uppercase">Node Status: @order.Status</span>
                    </div>
                </div>

                <div class="card-body p-3">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-7">
                            <h6 class="fw-bold text-body-emphasis text-uppercase font-monospace small mb-2" style="font-size: 11px; letter-spacing: 0.5px;">Procured Strategic Line Components</h6>
                            @foreach (var item in order.OrderItems)
                            {
                                <div class="d-flex align-items-center gap-3 mb-2 border-bottom border-secondary-subtle pb-2 last-border-none">
                                    <img src="@item.Product?.ImageUrl" class="rounded border border-secondary-subtle bg-light object-fit-cover" style="width: 45px; height: 45px;" alt="" />
                                    <div class="flex-grow-1">
                                        <h6 class="m-0 fw-bold small">
                                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-body-emphasis hover-text-primary">@item.Product?.Name</a>
                                        </h6>
                                        <small class="text-body-secondary font-monospace" style="font-size: 11px;">Allocated Load: @item.Quantity Multipliers &bull; Unit Cost: $@item.PriceAtPurchase.ToString("F2")</small>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-5 border-start border-secondary-subtle ps-md-4 text-md-end text-start">
                            @if (order.Status == ShieldOps.Models.OrderStatus.Delivered)
                            {
                                <div class="d-flex flex-column gap-2 max-width-250 ms-md-auto">
                                    @foreach (var item in order.OrderItems.Take(1))
                                    {
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-primary btn-sm fw-bold text-uppercase py-2 shadow-xs"><i class="bi bi-chat-left-dots-fill"></i> Authorize Feature Evaluation</a>
                                    }

                                    @if (order.ReturnState == ReturnStatus.None)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm fw-bold text-uppercase py-2 shadow-xs" data-bs-toggle="modal" data-bs-target="#returnModal-@order.Id">
                                            <i class="bi bi-arrow-left-right"></i> Initialize Asset Reversal
                                        </button>
                                    }
                                    else if (order.ReturnState == ReturnStatus.Pending)
                                    {
                                        <div class="alert alert-warning border-0 p-2 m-0 text-center small fw-semibold rounded shadow-xs text-warning bg-warning-subtle" role="alert">
                                            <i class="bi bi-hourglass-split"></i> Audit Approval Awaiting Validation
                                        </div>
                                    }
                                    else if (order.ReturnState == ReturnStatus.Approved)
                                    {
                                        <div class="alert alert-success border-0 p-3 m-0 text-start small rounded shadow-xs text-success bg-success-subtle" role="alert">
                                            <strong class="d-block mb-1"><i class="bi bi-patch-check-fill"></i> Reverse Pipeline Cleared!</strong>
                                            <small class="d-block opacity-75">@order.AdminReturnNotes</small>
                                        </div>
                                    }
                                    else if (order.ReturnState == ReturnStatus.Rejected)
                                    {
                                        <div class="alert alert-danger border-0 p-3 m-0 text-start small rounded shadow-xs text-danger bg-danger-subtle" role="alert">
                                            <strong class="d-block mb-1"><i class="bi bi-shield-x"></i> Reversal System Disapproved</strong>
                                            <small class="d-block mt-1 text-body"><strong>Reason Context:</strong> @order.AdminReturnNotes</small>
                                        </div>
                                    }
                                </div>

                                <div class="modal fade" id="returnModal-@order.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start bg-body border border-secondary-subtle">
                                            <div class="modal-header bg-dark text-white border-bottom border-secondary-subtle">
                                                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill text-danger"></i> Compliance Return Manifest Setup</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-controller="Order" asp-action="RequestAssetReturn" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <div class="modal-body p-3">
                                                    <p class="small text-body-secondary mb-3">Please specify rigorous technical structural failure feedback logs. This action initializes secure stock reversal tracks.</p>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold small text-uppercase text-body-emphasis">Audit Exception Rationale Statement</label>
                                                        <textarea name="returnReason" class="form-control bg-body text-body border-secondary-subtle" rows="4" required placeholder="Specify endpoint mismatch configurations, damaged circuit vectors, configuration anomalies..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer bg-body-tertiary border-top border-secondary-subtle">
                                                    <button type="button" class="btn btn-secondary text-uppercase fw-bold small px-3" data-bs-dismiss="modal">Close</button>
                                                    <button type="submit" class="btn btn-danger text-uppercase fw-bold small px-3">Dispatch Query Payload</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-body-secondary small italic d-block"><i class="bi bi-truck-flatbed"></i> Package tracking routing map pipeline active. Feedback evaluations authorize once progress node locks onto final physical delivery confirmation tracks.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>