@{
    ViewData["Title"] = "System Firewall Breach Exception";
}

<div class="container text-center mt-5 pt-5">
    <div class="card shadow-lg border-0 bg-light p-5 rounded max-width-600 mx-auto border border-danger">
        <i class="bi bi-shield-slash-fill text-danger d-block mb-3" style="font-size: 70px;"></i>
        <h2 class="fw-bold text-dark mb-2">System Exception Pipeline Intercepted</h2>
        <p class="text-muted fs-5 mb-4">The Central Firewalls have trapped an unexpected memory segmentation crash or runtime asset violation constraint statement.</p>
        
        <div class="p-3 bg-dark text-warning rounded text-start font-monospace small mb-4">
            <i class="bi bi-terminal-fill"></i> System Status: Host operational memory protected. Raw terminal telemetry reports redirected to central log architecture.
        </div>
        
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-danger btn-lg text-uppercase fw-bold shadow-xs px-4"><i class="bi bi-arrow-left-circle"></i> Clear Cache and Bounce Back</a>
    </div>
</div>