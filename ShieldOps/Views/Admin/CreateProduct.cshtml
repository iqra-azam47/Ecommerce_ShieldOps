@model ShieldOps.Models.Product
@{
    ViewData["Title"] = "Deploy Cyber Defensive Asset Countermeasure";
}

<div class="row justify-content-center mt-4 pb-5 mb-5">
    <div class="col-md-8">
        <div class="card shadow-lg border border-secondary-subtle rounded-3 overflow-hidden bg-body">
            
            <div class="card-header bg-dark text-white py-3 border-0">
                <h4 class="m-0 fw-bold"><i class="bi bi-cloud-plus-fill text-info"></i> Deploy New Defensive Countermeasure Asset</h4>
            </div>
            
            <div class="card-body p-4 bg-body text-body">
                <form asp-controller="Admin" asp-action="CreateProduct" method="post" enctype="multipart/form-data" class="m-0">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label fw-bold text-body-emphasis small text-uppercase font-monospace" style="letter-spacing: 0.5px;">Strategic Asset Identifier Title</label>
                            <input asp-for="Name" class="form-control bg-body text-body-emphasis border-secondary-subtle py-2" placeholder="e.g. ShieldX Vault Core" required />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold text-body-emphasis small text-uppercase font-monospace" style="letter-spacing: 0.5px;">Strategic Domain Node Category</label>
                            <select asp-for="CategoryId" class="form-select bg-body text-body-emphasis border-secondary-subtle fw-bold text-primary py-2" asp-items="ViewBag.CategoryList" required></select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold text-body-emphasis small text-uppercase font-monospace" style="letter-spacing: 0.5px;">Technical Specifications Dossier Overview</label>
                        <textarea asp-for="Description" class="form-control bg-body text-body-emphasis border-secondary-subtle" rows="4" placeholder="Enter high-level architecture overview parameters details logs..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Price" class="form-label fw-bold text-body-emphasis small text-uppercase font-monospace" style="letter-spacing: 0.5px;">Unit Purchase Value Surcharge ($)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control bg-body text-body-emphasis border-secondary-subtle py-2 font-monospace" placeholder="0.00" required />
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="StockQuantity" class="form-label fw-bold text-body-emphasis small text-uppercase font-monospace" style="letter-spacing: 0.5px;">Initial Inventory Allocation Units</label>
                            <input asp-for="StockQuantity" type="number" class="form-control bg-body text-body-emphasis border-secondary-subtle py-2 font-monospace" placeholder="0" required />
                            <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Type" class="form-label fw-bold text-body-emphasis small text-uppercase font-monospace" style="letter-spacing: 0.5px;">Deployment Structure Type</label>
                            <select asp-for="Type" class="form-select bg-body text-body-emphasis border-secondary-subtle fw-bold text-info py-2" asp-items="Html.GetEnumSelectList<ShieldOps.Models.ProductType>()" required></select>
                            <span asp-validation-for="Type" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4 bg-body-tertiary p-3 rounded-3 border border-secondary-subtle shadow-2xs">
                        <label class="form-label fw-bold text-body-emphasis small text-uppercase font-monospace" style="letter-spacing: 0.5px;"><i class="bi bi-image text-primary"></i> Upload Graphic Visual Blueprint Matrix (Product Image File)</label>
                        <input type="file" name="productImageFile" class="form-control bg-body border-secondary-subtle text-body-secondary" accept="image/*" />
                        <small class="text-body-secondary d-block mt-1 opacity-75">Accepts standard PNG, JPG or JPEG streams. Default imagery is injected if left unallocated.</small>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" asp-fragment="products-panel" class="btn btn-secondary px-4 fw-bold text-uppercase small py-2">Abort Strategy</a>
                        <button type="submit" class="btn btn-info text-dark fw-bold px-5 text-uppercase small py-2 shadow-xs">Publish Countermeasure Asset</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}