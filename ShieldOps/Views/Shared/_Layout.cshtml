@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    // Database bypass session parameters reading
    var sessionEmail = HttpContextAccessor.HttpContext?.Session.GetString("VerifiedUserEmail");
    var sessionRole = HttpContextAccessor.HttpContext?.Session.GetString("VerifiedUserRole");
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light" id="theme-root" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShieldOps</title>
    <link class="styles" rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShieldOps.styles.css" asp-append-version="true" />
    <style>
        /* Forces the container to expand and pushes the footer down naturally */
        .main-content-wrapper {
            flex: 1 0 auto;
        }
        .footer-sticky-lock {
            flex-shrink: 0;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3 transition-all" id="main-navbar">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Catalog" asp-action="Index">
                    <i class="bi bi-shield-fill text-primary"></i> ShieldOps
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill text-muted"></i> Home Hub
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold" asp-area="" asp-controller="Catalog" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap-fill text-muted"></i> Defensive Catalog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 text-muted"></i> Cart Ledger
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold" asp-area="" asp-controller="Order" asp-action="MyOrders">
                                <i class="bi bi-folder-symlink-fill text-muted"></i> My Orders
                            </a>
                        </li>
                        
                        @if (!string.IsNullOrEmpty(sessionEmail) && sessionRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold shadow-sm rounded border border-danger px-2 ms-2" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill"></i> Command Admin
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-3">
                            <button class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center" id="themeToggleBtn" style="width: 35px; height: 35px;" title="Switch Interface Mode">
                                <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                            </button>
                        </li>

                        @if (!string.IsNullOrEmpty(sessionEmail))
                        {
                            <li class="nav-item">
                                <span class="nav-link font-weight-bold text-dark-emphasis">Hello, @sessionEmail</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline m-0 p-0">
                                    <button type="submit" class="nav-link btn btn-link border-0 fw-bold text-secondary">Sign Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Account" asp-action="Register">Create Account</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Account" asp-action="Login">Login Portal</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-2">
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-2">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-octagon-fill"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <main role="main" class="main-content-wrapper w-100 decimal-matrix py-4 py-md-5">
        @RenderBody()
    </main>

    <footer class="footer-sticky-lock border-top text-muted py-5 bg-body-tertiary w-100">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-5 col-md-6">
                    <h5 class="text-dark-emphasis fw-bold mb-3">
                        <i class="bi bi-shield-fill text-primary"></i> ShieldOps Countermeasure Matrix
                    </h5>
                    <p class="small text-secondary mb-3" style="text-align: justify; max-width: 400px;">
                        An advanced autonomous enterprise countermeasure portal designed for hardware asset audits, packet sniffer configurations, and cryptographic license shield provisioning.
                    </p>
                    <div class="p-2 bg-body rounded border d-inline-block shadow-xs" style="font-size: 12px;">
                        <i class="bi bi-mortarboard-fill text-primary me-1"></i> Academic Project Baseline &bull; <strong>PU</strong>
                    </div>
                </div>

                <div class="col-lg-3 col-6 col-md-3">
                    <h6 class="text-dark-emphasis fw-bold text-uppercase mb-3" style="font-size: 12px; letter-spacing: 1px;">Navigation Links</h6>
                    <ul class="list-unstyled mb-0" style="font-size: 14px;">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted-hover"><i class="bi bi-chevron-right small text-primary"></i> Home Hub</a></li>
                        <li class="mb-2"><a asp-controller="Catalog" asp-action="Index" class="text-decoration-none text-muted-hover"><i class="bi bi-chevron-right small text-primary"></i> Defensive Catalog</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-muted-hover"><i class="bi bi-cart3 small text-primary"></i> Cart Ledger</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-6 col-md-3">
                    <h6 class="text-dark-emphasis fw-bold text-uppercase mb-3" style="font-size: 12px; letter-spacing: 1px;">Help & Support Desks</h6>
                    <ul class="list-unstyled mb-0" style="font-size: 13px;">
                        <li class="mb-2 d-flex align-items-start gap-2">
                            <i class="bi bi-envelope-fill text-primary mt-1"></i>
                            <div>
                                <span class="d-block text-secondary small">Infrastructure Support:</span>
                                <a href="mailto:support@shieldops.cyber" class="text-decoration-none fw-semibold">support@shieldops.cyber</a>
                            </div>
                        </li>
                        <li class="mb-2 d-flex align-items-start gap-2">
                            <i class="bi bi-telephone-fill text-success mt-1"></i>
                            <div>
                                <span class="d-block text-secondary small">Secure Hotline Matrix:</span>
                                <span class="font-monospace text-dark-emphasis">+92 (42) 111-SHIELD</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="border-top pt-3 d-flex flex-column flex-md-row justify-content-between align-items-center" style="font-size: 13px;">
                <div class="mb-2 mb-md-0 text-center text-md-start">
                    &copy; 2026 - <span class="fw-bold text-dark-emphasis">ShieldOps Inc.</span> All Rights Reserved System Logs.
                </div>
                <div class="text-center text-md-end">
                    <span>
                        <i class="bi bi-code-slash text-primary"></i> Architecture Developed by: <strong class="text-dark-emphasis">Iqra Azam</strong>
                    </span>
                    <span class="mx-2 text-muted d-none d-md-inline">|</span>
                    <span class="text-uppercase font-monospace text-secondary fw-semibold">
                        Roll No: BCS23035
                    </span>
                    <span class="mx-2 text-muted d-none d-md-inline">|</span>
                    <span class="text-body-secondary">
                        University of the Punjab
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeIcon = document.getElementById('themeIcon');
        const themeRoot = document.getElementById('theme-root');
        const mainNavbar = document.getElementById('main-navbar');

        function applyTheme(theme) {
            if (theme === 'dark') {
                themeRoot.setAttribute('data-bs-theme', 'dark');
                mainNavbar.classList.remove('navbar-light', 'bg-white');
                mainNavbar.classList.add('navbar-dark', 'bg-dark');
                themeIcon.classList.remove('bi-moon-stars-fill');
                themeIcon.classList.add('bi-sun-fill');
                themeToggleBtn.classList.remove('btn-outline-secondary');
                themeToggleBtn.classList.add('btn-outline-warning');
            } else {
                themeRoot.setAttribute('data-bs-theme', 'light');
                themeRoot.setAttribute('data-bs-theme', 'light');
                mainNavbar.classList.remove('navbar-dark', 'bg-dark');
                mainNavbar.classList.add('navbar-light', 'bg-white');
                themeIcon.classList.remove('bi-sun-fill');
                themeIcon.classList.add('bi-moon-stars-fill');
                themeToggleBtn.classList.remove('btn-outline-warning');
                themeToggleBtn.classList.add('btn-outline-secondary');
            }
        }

        const savedTheme = localStorage.getItem('shieldops-theme') || 'light';
        applyTheme(savedTheme);

        themeToggleBtn.addEventListener('click', () => {
            const currentTheme = themeRoot.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';
            localStorage.setItem('shieldops-theme', newTheme);
            applyTheme(newTheme);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>